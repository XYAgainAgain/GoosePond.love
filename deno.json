{
  "tasks": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "deno test --allow-read=src src/",
    "check": "deno check src/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ],
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve"
  },
  "exclude": [
    ".dev/",
    ".claude/",
    "dist/"
  ]
}
